# Copy to .env.local and fill in. Never commit the filled copy.

# Required. At least 32 random characters. Session tokens are stored as an
# HMAC under this secret, so a copy of the database alone cannot be used to
# forge or recognise a session. Rotating it ends every session.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Where the database, the configuration and the history live.
# Defaults to ./data. A container mounts a volume here.
# DATA_DIR=/var/lib/hotel-dashboard

# Optional, demonstration data only. The seed refuses to run when this is
# "production", so fictional records can never be written into a live
# instance.
# HOTEL_ENV=production
